---
import type { Service } from '../lib/content';
import Icon from './Icon.astro';
import { useTranslations, localePath, type Lang } from '../i18n/utils';
interface Props { pillar: Service; lang: Lang; index: number }
const { pillar, lang, index } = Astro.props;
const t = useTranslations(lang);
const d = pillar.data;
---
<a class="card card--link pillar" href={localePath(lang, `/services#${d.anchor}`)}>
  <div class="pillar__top">
    <span class="icon-tile"><Icon name={d.icon} /></span>
    <span class="pillar__num">0{index}</span>
  </div>
  <h3>{d.title}</h3>
  <p class="pillar__summary">{d.summary}</p>
  <div class="pillar__foot">
    {d.cardPrice ? (
      <span class="price">{t('price.from')}<strong>{d.cardPrice.toLocaleString(lang === 'nl' ? 'nl-BE' : 'en-IE')}</strong><small>{t('price.vat')}</small></span>
    ) : (
      <span class="price"><small>{t('price.dayRate')}</small></span>
    )}
    <span class="card__arrow"><Icon name="arrow" /></span>
  </div>
</a>
<style>
  .pillar { gap: 0.9rem; }
  .pillar__top { display: flex; justify-content: space-between; align-items: flex-start; }
  .pillar__num { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.1em; color: var(--muted); font-variant-numeric: tabular-nums; }
  .pillar h3 { margin: 0.2rem 0 0; }
  .pillar__summary { color: var(--text-2); margin: 0; font-size: 0.98rem; }
  .pillar__foot { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 0.5rem; }
  .card__arrow :global(.icon) { width: 22px; height: 22px; }
</style>
