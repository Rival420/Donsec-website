---
import { useTranslations, localePath, type Lang } from '../i18n/utils';
interface Props { lang: Lang; title?: string; body?: string }
const { lang, title, body } = Astro.props;
const t = useTranslations(lang);
---
<section class="section section--navy cta">
  <div class="container cta__inner">
    <div>
      <h2>{title ?? t('hero.pitch')}</h2>
      {body && <p class="lead">{body}</p>}
    </div>
    <div class="cta__actions">
      <a class="btn btn--primary" href={localePath(lang, '/contact')}>{t('cta.book')}</a>
      <a class="btn btn--secondary" href={localePath(lang, '/services')}>{t('cta.services')}</a>
    </div>
  </div>
</section>
<style>
  .cta { background-image: url('/brand/pattern-tile.svg'); background-size: 210px; }
  .cta__inner { display: flex; flex-wrap: wrap; gap: 28px 48px; align-items: center; justify-content: space-between; }
  .cta h2 { max-width: 24ch; margin-bottom: 0; font-size: clamp(1.5rem, 3vw, 2.1rem); }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
