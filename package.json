{
  "name": "donsec-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "donsec.be — DonIT&Security website. Astro on Cloudflare Workers.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check",
    "types": "wrangler types",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply donsec-website --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply donsec-website --remote",
    "db:seed": "node scripts/seed-from-content.mjs",
    "deploy:preview": "astro build && wrangler versions upload",
    "docker:build": "docker compose run --rm build",
    "docker:dev": "docker compose up dev"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.7",
    "jose": "^6.2.15",
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "js-yaml": "^5.5.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
